# Public site URL — used for canonical links, og:url and JSON-LD structured data.
# Local-only value below. Set the real production domain (no trailing slash) as
# an env var on the deploy platform — if unset there, the code falls back to
# the current production URL hardcoded in companyInfo.ts, not to this value.
VITE_SITE_URL=http://localhost:5173

# Sentry (Error Tracking & Performance Monitoring)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# E2E tests (Playwright) — base URL for the app under test. Tests run against
# the production build via `pnpm build && pnpm preview` (port 4173), not the
# dev server.
PLAYWRIGHT_BASE_URL=http://localhost:4173
